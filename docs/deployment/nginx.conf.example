# Single-host template. Replace the domain, certificates and release path.
# Include in the nginx http context, after provisioning a TLS certificate.
server {
    listen 80;
    server_name dashboard.example.com;
    return 301 https://dashboard.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name dashboard.example.com;
    ssl_certificate /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /srv/sebit/current/sebitcanvers_v3/frontend/dist;
    index index.html;
    client_max_body_size 512k;
    client_body_timeout 15s;

    location ~ /\. { deny all; }
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # OVERWRITE, never append $proxy_add_x_forwarded_for here.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_next_upstream off;
        proxy_cache off;
        proxy_buffering off;
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
