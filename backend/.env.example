HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
# Explicit additional local frontend origins (no wildcard). Remove unused addresses in deployment.
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
OPENAI_API_KEY=
# Responses API JSON mode supported model available to your account
OPENAI_MODEL=
AI_TIMEOUT_MS=60000
AI_RATE_LIMIT=5
AI_CONCURRENCY=2
AI_MAINTENANCE=false
# Korea Standard Time midnight reset; successful requests only.
AI_DAILY_GENERATE=5
AI_DAILY_EDIT=20
# Shared-IP safety caps; adjust for offices/proxy deployment before release.
AI_DAILY_IP_GENERATE=50
AI_DAILY_IP_EDIT=200
# Persistent local SQLite file; run backend with Node.js 24+.
AI_USAGE_DB=./data/ai-usage.sqlite
# Provider attempts and request results, without prompt/response bodies.
AI_TELEMETRY_DB=./data/ai-events.sqlite
